+class LookupTextEncoder(nn.Module):
+    """Pre-encoded contexts of a fixed caption set (``scripts/encode_captions.py``): ``{caption: (L, ctx_dim) bf16}``
+    on the host. Same ``forward_bucketed`` / ``forward_bucketed_batch`` contract as :class:`Qwen3VLEmbedder`;
+    an unknown caption is an error (the set is closed). Holds no parameters, so nothing sits on the GPU."""
+
+    is_mock = False
+
+    def __init__(self, path: str):
+        super().__init__()
+        self.path = path
+        self.table: dict[str, Tensor] = torch.load(path, map_location="cpu", weights_only=True)
+        if "" not in self.table:
+            raise ValueError(f"{path} lacks the empty caption (the classifier-free-guidance null)")
+
+    def forward_bucketed(self, text: str, *, fixed_length: int | None = None) -> Tensor:
+        return self.forward_bucketed_batch([text], fixed_length=fixed_length)[0]
+
+    def forward_bucketed_batch(self, texts: list[str], *, fixed_length: int | None = None) -> list[Tensor]:
+        out = []
+        for text in texts:
+            ctx = self.table.get(text)
+            if ctx is None:
+                raise KeyError(f"caption not in the pre-encoded table {self.path}: {text!r}")
+            if fixed_length is not None:
+                ctx = ctx[:fixed_length] if ctx.shape[0] >= fixed_length else torch.cat(
+                    [ctx, self.table[""][ctx.shape[0] : fixed_length]])
+            out.append(ctx[None])
+        return out
+
+
