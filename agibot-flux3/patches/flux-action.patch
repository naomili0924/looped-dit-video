+++ b/src/flux_action/training/reduce_guard.py
@@ -0,0 +1,76 @@
+"""Cross-rank check of FSDP2's gradient reduce-scatter sequence.
+
+NCCL matches collectives by issue order and does not check sizes: two ranks that reduce-scatter the same
+parameter groups in a different order (or different groups) silently add the wrong gradients together as
+long as the byte totals line up, and hang when they do not (seen in the Phase-3 run: a text-only micro-batch
+gives the context stream no gradient, so FSDP2 reduce-scatters those blocks from its final autograd callback,
+after every other group, instead of in backward order). ``JointSingleSeq`` now ties every stream into the
+loss so the sequence no longer depends on the data; this guard verifies that on every update.
+
+The guard wraps ``FSDPParamGroup.post_backward`` (process-wide), records the groups reduced in the synced
+micro-batch, and ``check`` compares the sequence across ranks with one small ``all_gather_object``.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import torch.distributed as dist
+from torch.distributed.fsdp._fully_shard import _fsdp_param_group as _pg
+
+
+class ReduceOrderGuard:
+    _installed: ReduceOrderGuard | None = None
+
+    def __init__(self) -> None:
+        self.records: list[tuple[str, bool]] = []  # (group fqn, had a gradient to reduce)
+        self.enabled = True
+        self._noop_reported = False
+        if ReduceOrderGuard._installed is None:
+            original = _pg.FSDPParamGroup.post_backward
+
+            def traced(group: Any, *args: Any, **kwargs: Any) -> Any:
+                guard = ReduceOrderGuard._installed
+                if guard is not None and guard.enabled and group.reduce_grads:
+                    has = any(
+                        fp.unsharded_accumulated_grad is not None
+                        or (hasattr(fp, "_unsharded_param") and fp._unsharded_param.grad is not None)
+                        for fp in group.fsdp_params
+                    )
+                    guard.records.append((_clean(group._module_fqn or "root"), has))
+                return original(group, *args, **kwargs)
+
+            _pg.FSDPParamGroup.post_backward = traced
+        ReduceOrderGuard._installed = self
+
+    def check(self, step: int) -> list[str]:
+        """Raise ``RuntimeError`` when the ranks reduced different groups or in a different order (or a
+        trainable group had nothing to reduce on some rank). Returns this rank's sequence; clears it."""
+        # A post_backward without a gradient issues no collective (FSDP2 returns before foreach_reduce), so only the
+        # calls that had something to reduce form the sequence. The no-op calls are normal for a block that is used
+        # several times per forward (the Looped-DiT core and post blocks: one post_backward per use, gradients
+        # arriving in some of them); they matter only if they make the sequences differ across ranks.
+        mine = [fqn for fqn, has in self.records if has]
+        noop = [fqn for fqn, has in self.records if not has]
+        self.records = []
+        gathered: list[dict | None] = [None] * dist.get_world_size()
+        dist.all_gather_object(gathered, {"seq": mine, "noop": noop})
+        seqs = [g["seq"] for g in gathered]  # type: ignore[index]
+        if noop and not self._noop_reported and dist.get_rank() == 0:
+            self._noop_reported = True
+            print(f"[reduce-guard] step {step}: {len(noop)} post_backward calls without a gradient (no collective), "
+                  f"e.g. {sorted(set(noop))[:4]}; {len(mine)} groups reduced", flush=True)
+        for rank, seq in enumerate(seqs[1:], start=1):
+            if seq != seqs[0]:
+                first = next((i for i, (a, b) in enumerate(zip(seqs[0], seq)) if a != b), min(len(seqs[0]), len(seq)))
+                raise RuntimeError(
+                    f"step {step}: FSDP reduce-scatter sequence differs between rank 0 and rank {rank} "
+                    f"({len(seqs[0])} vs {len(seq)} groups; first difference at {first}: "
+                    f"{seqs[0][first:first + 3]} vs {seq[first:first + 3]}). NCCL would silently add the wrong "
+                    "gradients together (or hang); the batches of this update differ in structure across ranks."
+                )
+        return mine
+
+
+def _clean(fqn: str) -> str:
+    return fqn.replace("_checkpoint_wrapped_module.", "").replace("_orig_mod.", "")
