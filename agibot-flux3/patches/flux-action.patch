+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Low-memory training state for full finetunes on few GPUs: 8-bit AdamW over FSDP2 shards and a CPU EMA.
+
+Both keep per-rank state (``per_rank_state = True``): the checkpoint stores one file per rank instead of a
+DCP shard set, so a resume needs the same world size (the trainer's global-batch check already pins it).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from typing import Any
+
+import torch
+from torch import Tensor, nn
+
+from .distributed import clean_name
+
+
+def _local(t: Tensor) -> Tensor:
+    from torch.distributed.tensor import DTensor
+
+    return t.to_local() if isinstance(t, DTensor) else t
+
+
+def _reshard(module: nn.Module) -> None:
+    """Free any unsharded FSDP2 parameter copies so ``named_parameters`` yields the sharded DTensors."""
+    try:
+        from torch.distributed.fsdp import FSDPModule
+    except ImportError:  # no FSDP2 in this torch
+        return
+    for m in module.modules():
+        if isinstance(m, FSDPModule):
+            m.reshard()
+
+
+class LocalShardAdamW8bit(torch.optim.Optimizer):
+    """bitsandbytes ``AdamW8bit`` stepping each rank's local shard of FSDP2 (DTensor) parameters in place.
+
+    ``param_groups`` hold the model's parameters (LR schedulers and grad clipping act on them as usual); an
+    inner bitsandbytes optimizer holds Parameters that alias the local shards. Gradients are global-norm
+    clipped by the trainer before ``step``; the local shard update equals the unsharded update elementwise.
+    """
+
+    per_rank_state = True
+
+    def __init__(self, params: Iterable[dict[str, Any]], *, lr: float, betas, eps: float, weight_decay: float):
+        import bitsandbytes as bnb
+
+        super().__init__(list(params), dict(lr=lr, betas=tuple(betas), eps=eps, weight_decay=weight_decay))
+        inner_groups = []
+        self._aliases: list[list[tuple[nn.Parameter, nn.Parameter]]] = []
+        for group in self.param_groups:
+            pairs = []
+            for p in group["params"]:
+                alias = nn.Parameter(_local(p.data), requires_grad=True)  # shares the shard's storage
+                pairs.append((p, alias))
+            self._aliases.append(pairs)
+            inner_groups.append({"params": [a for _, a in pairs], "lr": group["lr"]})
+        self.inner = bnb.optim.AdamW8bit(inner_groups, lr=lr, betas=tuple(betas), eps=eps, weight_decay=weight_decay)
+
+    @torch.no_grad()
+    def step(self, closure=None):
+        assert closure is None, "closures are not supported"
+        for group, inner, pairs in zip(self.param_groups, self.inner.param_groups, self._aliases, strict=True):
+            inner["lr"] = group["lr"]
+            for p, alias in pairs:
+                alias.grad = None if p.grad is None else _local(p.grad)
+        self.inner.step()
+        for pairs in self._aliases:
+            for _, alias in pairs:
+                alias.grad = None
+
+    def zero_grad(self, set_to_none: bool = True):
+        super().zero_grad(set_to_none=set_to_none)
+
+    def state_dict(self) -> dict[str, Any]:
+        return {"inner": self.inner.state_dict(), "lrs": [g["lr"] for g in self.param_groups]}
+
+    def load_state_dict(self, state: dict[str, Any]) -> None:
+        self.inner.load_state_dict(state["inner"])
+        for g, lr in zip(self.param_groups, state["lrs"], strict=True):
+            g["lr"] = lr
+
+
+class CPUEMA:
+    """Classic EMA ``ema = d * ema + (1 - d) * param`` of the trainable parameters, fp32 in pinned host memory
+    (each rank its local shards), updated every ``every`` optimizer updates with the decay compounded.
+
+    Warm-up: ``d = min(decay, (1 + step) / (10 + step))`` so a short run does not keep the initialization for
+    ~1 / (1 - decay) updates; the first update copies the model. Same interface as ``PowerEMA`` where the trainer
+    and checkpoint use it (``names``, ``last_step``, ``update_from_module``, ``state_dict``).
+    """
+
+    per_rank_state = True
+    sigma_rel = None
+
+    def __init__(self, named: Iterable[tuple[str, Tensor]], decay: float, every: int = 1):
+        self.decay, self.every, self.last_step = float(decay), max(1, int(every)), -1
+        self.names, self.shadow, self.global_shapes = [], [], []
+        for name, p in named:
+            local = _local(p.detach())
+            self.names.append(name)
+            self.shadow.append(torch.empty(local.shape, dtype=torch.float32, device="cpu").pin_memory())
+            self.global_shapes.append(tuple(p.shape))
+
+    @classmethod
+    def from_module(cls, module: nn.Module, decay: float, every: int = 1) -> CPUEMA:
+        return cls(((clean_name(n), p) for n, p in module.named_parameters() if p.requires_grad), decay, every)
+
+    def _params(self, module: nn.Module) -> list[Tensor]:
+        _reshard(module)  # FSDP2 may hold unsharded copies (e.g. right after a checkpoint write): use the shards
+        by_name = {clean_name(n): p for n, p in module.named_parameters()}
+        return [_local(by_name[n].detach()) for n in self.names]
+
+    @torch.no_grad()
+    def update_from_module(self, module: nn.Module, step: int) -> float | None:
+        """``step`` = optimizer updates done so far (1 after the first). Returns the decay applied, or None."""
+        first = self.last_step < 0
+        if not first and step % self.every:
+            return None
+        params = [p.float().to("cpu", non_blocking=True) for p in self._params(module)]
+        torch.cuda.synchronize()
+        if first:
+            for s, p in zip(self.shadow, params, strict=True):
+                s.copy_(p)
+            d = 0.0
+        else:
+            d = min(self.decay, (1 + step) / (10 + step)) ** self.every
+            torch._foreach_lerp_(self.shadow, params, 1.0 - d)
+        self.last_step = step
+        return d
+
+    @torch.no_grad()
+    def swap_into(self, module: nn.Module) -> list[Tensor]:
+        """Load the EMA into the model's shards; returns the stash for :meth:`restore`."""
+        params = self._params(module)
+        stash = [p.to("cpu", copy=True) for p in params]
+        for p, s in zip(params, self.shadow, strict=True):
+            p.copy_(s.to(p.device, p.dtype, non_blocking=True))
+        return stash
+
+    @torch.no_grad()
+    def restore(self, module: nn.Module, stash: list[Tensor]) -> None:
+        for p, s in zip(self._params(module), stash, strict=True):
+            p.copy_(s.to(p.device, non_blocking=True))
+
+    def state_dict(self) -> dict[str, Any]:
+        return {"names": self.names, "tensors": self.shadow, "last_step": self.last_step, "decay": self.decay,
+                "every": self.every, "global_shapes": self.global_shapes}
+
+    def load_state_dict(self, state: dict[str, Any]) -> None:
+        if list(state["names"]) != self.names:
+            raise ValueError("EMA parameter names differ from the checkpoint")
+        for s, t in zip(self.shadow, state["tensors"], strict=True):
+            s.copy_(t)
+        self.last_step = int(state["last_step"])
