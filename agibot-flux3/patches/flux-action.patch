--- /dev/null
+++ b/src/flux_action/models/looped.py
@@ -0,0 +1,218 @@
+"""Looped-DiT retrofit of ``JointSingleSeq`` (Chng et al., 2026, arXiv 2609.40305; reference implementation
+``looped-dit-video/ldv/model.py``).
+
+The blocks (mode blocks first, then the joint single blocks) are split into three stages::
+
+    pre-loop  A  the first ``pre`` blocks      run once   (all mode blocks + the first single blocks)
+    looped    B  the next ``core`` single blocks run N times with shared weights
+    post-loop C  the last ``post`` single blocks run once, then the final layers
+
+    h_0 = A(x),  h_r = B(h_{r-1}),  prediction(r) = C(h_r),  r = 1..N
+
+Every loop state can be decoded through C: deep supervision in training (one velocity loss per exit, weighted),
+a variable loop depth at inference (``num_loops``). The looped blocks carry self-modulating attention: a
+modality-specific head-wise sigmoid gate on the attention output (Qiu et al., 2025), G = sigmoid(W_g u + b_g)
+with u the block's modulated input; initialised with zero weights and bias ``attn_gate_init`` (+4 keeps a
+pretrained block's function: G = 0.982 everywhere). Exclusive self-attention (XSA) is available as an ablation.
+
+Everything else (packing, modulations, RoPE, heads, FSDP/AC/compile per block) is the backbone's: the core
+blocks are ordinary ``single_blocks[pre - depth : pre - depth + core]`` run repeatedly, so a checkpoint of the
+plain fine-tune loads directly (the gates are the only new parameters).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+import torch.nn.functional as F
+from torch import Tensor, nn
+
+from .transformer import JointSingleSeq, JointSingleSeqParams
+
+WEIGHT_SUM = 2.0  # deep-supervision weights are rescaled to this total (as in the reference)
+
+
+@dataclass
+class LoopParams:
+    loop_split: tuple[int, int, int] = (12, 9, 12)  # (pre, core, post) over [mode blocks, single blocks]
+    num_loops: int = 4
+    attn_gate: bool = True
+    attn_gate_init: float = 4.0
+    xsa: bool = False
+
+    def __post_init__(self):
+        self.loop_split = tuple(int(n) for n in self.loop_split)
+        if len(self.loop_split) != 3 or min(self.loop_split) < 1:
+            raise ValueError(f"loop_split must be three positive block counts, got {self.loop_split}")
+        if self.num_loops < 1:
+            raise ValueError("num_loops must be >= 1")
+
+
+def deep_supervision_weights(num_loops: int, weighting: str) -> list[float]:
+    """Loss weights (w_1, ..., w_N) of the exits after each loop, w_N the final one; rescaled to WEIGHT_SUM.
+
+    At N = 4 before rescaling: uniform 1,1,1,1 | final_plus_mean 1/3,1/3,1/3,1 | exponential 1/8,1/4,1/2,1."""
+    if num_loops < 2:
+        raise ValueError("deep supervision needs at least two loops")
+    if weighting == "uniform":
+        raw = [1.0] * num_loops
+    elif weighting == "final_plus_mean":
+        raw = [1.0 / (num_loops - 1)] * (num_loops - 1) + [1.0]
+    elif weighting == "exponential":
+        raw = [0.5 ** (num_loops - r) for r in range(1, num_loops + 1)]
+    else:
+        raise ValueError(f"unknown deep supervision weighting: {weighting!r}")
+    scale = WEIGHT_SUM / sum(raw)
+    return [w * scale for w in raw]
+
+
+def exclusive_self_attention(out: Tensor, v: Tensor) -> Tensor:
+    """XSA: remove from each token's attention output its component along the token's own value. (B, L, H, D)."""
+    v_hat = F.normalize(v.float(), dim=-1)
+    out_f = out.float()
+    return (out_f - (out_f * v_hat).sum(dim=-1, keepdim=True) * v_hat).to(out.dtype)
+
+
+class HeadGate(nn.Module):
+    """Self-modulating attention for one joint block: head-wise sigmoid gates (one projection for text tokens,
+    one for content tokens) on the attention output, and/or XSA. Plugged into ``SingleStreamBlock.attn_gate``."""
+
+    def __init__(self, hidden_size: int, num_heads: int, init_bias: float = 4.0, gated: bool = True,
+                 xsa: bool = False):
+        super().__init__()
+        self.num_heads, self.gated, self.xsa = num_heads, gated, xsa
+        if gated:
+            self.txt = nn.Linear(hidden_size, num_heads)
+            self.img = nn.Linear(hidden_size, num_heads)
+            for lin in (self.txt, self.img):
+                nn.init.zeros_(lin.weight)
+                nn.init.constant_(lin.bias, init_bias)
+
+    def forward(self, attn: Tensor, v: Tensor, x_mod: Tensor, token_is_txt: Tensor) -> Tensor:
+        """attn (B, L, H*D) attention output; v (B, H, L, D); x_mod (B, L, hidden) the block's modulated input;
+        token_is_txt (L,) bool."""
+        b, l, hd = attn.shape
+        a = attn.view(b, l, self.num_heads, hd // self.num_heads)
+        if self.xsa:
+            a = exclusive_self_attention(a, v.transpose(1, 2))
+        if self.gated:
+            g = torch.where(token_is_txt.view(1, l, 1), self.txt(x_mod), self.img(x_mod))  # (B, L, H)
+            a = a * torch.sigmoid(g.float()).unsqueeze(-1).to(a.dtype)
+        return a.reshape(b, l, hd)
+
+
+class LoopedJointSingleSeq(JointSingleSeq):
+    """``JointSingleSeq`` whose single blocks run as pre-loop / looped core / post-loop stages."""
+
+    def __init__(self, params: JointSingleSeqParams, loop: LoopParams):
+        super().__init__(params)
+        pre, core, post = loop.loop_split
+        if pre + core + post != params.depth + params.depth_single_blocks:
+            raise ValueError(f"loop_split {loop.loop_split} must cover all {params.depth} mode + "
+                             f"{params.depth_single_blocks} single blocks")
+        if pre < params.depth:
+            raise ValueError("the looped stage must consist of single (joint) blocks: pre >= depth")
+        if params.depth_late_blocks:
+            raise ValueError("late blocks are not supported with looping")
+        self.loop = loop
+        self.n_pre_single, self.core, self.post = pre - params.depth, core, post
+        if loop.attn_gate or loop.xsa:
+            for i in range(self.n_pre_single, self.n_pre_single + core):
+                self.single_blocks[i].attn_gate = HeadGate(params.hidden_size, params.num_heads,
+                                                           loop.attn_gate_init, loop.attn_gate, loop.xsa)
+
+    @property
+    def core_blocks(self) -> Sequence[nn.Module]:
+        return self.single_blocks[self.n_pre_single : self.n_pre_single + self.core]
+
+    def forward(  # type: ignore[override]
+        self,
+        ctx: Tensor,
+        ctx_ids: Tensor,
+        vector: Tensor,
+        timesteps_ctx: Tensor,
+        pag_single_layers: list[int] | None = None,
+        pag_strength: float = 1.0,
+        seqlens: dict[str, Sequence[int]] | None = None,
+        num_loops: int | None = None,
+        exit_loops: Sequence[int] = (),
+        **kwargs: Tensor,
+    ) -> dict[str, Any]:
+        """As ``JointSingleSeq.forward``; ``num_loops`` overrides the loop depth and ``exit_loops`` lists
+        intermediate depths r < num_loops to decode too, returned under ``out["exits"][r]`` (deep supervision)."""
+        n = self.loop.num_loops if num_loops is None else int(num_loops)
+        if n < 1:
+            raise ValueError(f"num_loops must be >= 1, got {n}")
+        exits = sorted({int(r) for r in exit_loops})
+        if any(not 1 <= r < n for r in exits):
+            raise ValueError(f"exit_loops must lie in [1, {n}), got {exits}")
+        state, st = self._prepare(ctx, ctx_ids, vector, timesteps_ctx, seqlens, kwargs)
+        pre = self.single_blocks[: self.n_pre_single]
+        state = self._run_blocks(pre, state, st, pag_single_layers, pag_strength)
+        saved = {}
+        for r in range(1, n + 1):
+            state = self._run_blocks(self.core_blocks, state, st, pag_single_layers, pag_strength,
+                                     offset=self.n_pre_single)
+            if r in exits:
+                saved[r] = state
+        out: dict[str, Any] = self._decode(state, st, pag_single_layers, pag_strength)
+        if exits:
+            out["exits"] = {r: self._decode(s, st, pag_single_layers, pag_strength) for r, s in saved.items()}
+        return out
+
+    def _decode(self, state, st, pag_single_layers, pag_strength) -> dict[str, Tensor]:
+        """Post-loop blocks and the heads: a loop state -> per-stream predictions."""
+        post = self.single_blocks[self.n_pre_single + self.core :]
+        state = self._run_blocks(post, state, st, pag_single_layers, pag_strength, offset=self.n_pre_single + self.core)
+        return self._head(state, st)
+
+
+NEW_PARAM_SUBSTRINGS = (".attn_gate.",)
+
+
+def build_looped_video_dit(
+    params: JointSingleSeqParams,
+    ckpt_path: str | None,
+    loop: LoopParams,
+    *,
+    device: str | torch.device = "cpu",
+    dtype: torch.dtype = torch.bfloat16,
+) -> LoopedJointSingleSeq:
+    """``build_video_dit`` for the looped model: the trunk's video/video_cond/text streams load strictly, the
+    attention gates keep their initialisation."""
+    from safetensors import safe_open
+
+    from .wiring import OPTIONAL_KEY_SUBSTRINGS, default_dtype, stream_of_key
+
+    with torch.device(device), default_dtype(dtype):
+        model = LoopedJointSingleSeq(params, loop)
+    if ckpt_path is not None:
+        keep = set(params.in_channels)
+        with safe_open(ckpt_path, framework="pt", device="cpu") as checkpoint:
+            sd = {k: checkpoint.get_tensor(k) for k in checkpoint.keys() if stream_of_key(k) in keep | {None, "txt"}}
+        res = model.load_state_dict({k: v.to(dtype) for k, v in sd.items()}, strict=False)
+        missing = [k for k in res.missing_keys
+                   if not any(s in k for s in OPTIONAL_KEY_SUBSTRINGS + NEW_PARAM_SUBSTRINGS)]
+        if missing or res.unexpected_keys:
+            raise ValueError(f"trunk mismatch: missing {missing[:6]}, unexpected {res.unexpected_keys[:6]}")
+    model.eval()
+    return model
+
+
+def load_overlay(dit: nn.Module, path: str, allow_missing: Sequence[str] = ("final_layer.video_cond", *NEW_PARAM_SUBSTRINGS)) -> dict:
+    """Overlay fine-tuned weights (e.g. ``hub_backup.py``'s consolidated EMA, keys as in the DiT state dict,
+    optionally ``dit.``-prefixed) on a built DiT. Nothing unexpected may be present; only ``allow_missing``
+    substrings may be absent (the frozen conditioning head is not in an EMA, the gates are new)."""
+    from safetensors.torch import load_file
+
+    own = dit.state_dict()
+    sd = {k.removeprefix("dit."): v for k, v in load_file(path, device="cpu").items()}
+    res = dit.load_state_dict({k: v.to(own[k].dtype) for k, v in sd.items() if k in own}, strict=False)
+    unexpected = [k for k in sd if k not in own]
+    missing = [k for k in res.missing_keys if not any(s in k for s in allow_missing)]
+    if unexpected or missing:
+        raise ValueError(f"overlay mismatch: unexpected {unexpected[:6]}, missing {missing[:6]}")
+    return {"loaded": len(sd) - len(unexpected), "missing": res.missing_keys}
