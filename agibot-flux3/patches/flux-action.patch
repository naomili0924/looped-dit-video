+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Video-only windows (``PolicyConfig.video_only``): k observed frames + text -> F future frames, no action streams.
+
+A window holds ``k + F`` frames at ``fps``: ``k`` context frames, then ``future_frames`` frames to predict. ``k``
+is shared by the windows of a micro-batch (``batch["context_frames"]``) and may be 0 (text only). The context
+clip and the future clip are VAE-encoded independently (see :func:`encode_clip`), so trimming the context never changes the future latents; both lengths must lie on the causal VAE's
+``1 + 4n`` grid. Context latents go to ``x_video_cond`` (clean, timestep 0, no loss); future latents are
+``x_video``, the only stream with a loss.
+
+Time ids on the 10 ms clock, context start = 0: a causal latent sits at the time of its last frame, so context
+latent ``j`` is at ``4 j / fps`` and future latent ``i`` at ``(k + 4 i) / fps``; the gap between the last context
+frame and future latent ``i`` is ``(4 i + 1) / fps`` for every ``k``.
+"""
+
+from __future__ import annotations
+
+import torch
+from torch import Tensor
+
+from ..models.positional import batched_prc_vid, times_to_ids
+from . import packing
+
+
+def check_frames(n_frames: int, what: str) -> None:
+    if n_frames and (n_frames - 1) % packing.TEMPORAL_DOWNSAMPLE:
+        raise ValueError(f"{what}: {n_frames} frames is not on the VAE's 1 + 4n grid")
+
+
+@torch.no_grad()
+def encode_clip(vae, videos: Tensor, latent_hw: tuple[int, int]) -> Tensor:
+    """``(B, 3, T, Hc, Wc)`` in [-1, 1] -> ``(B, 96, 1 + (T - 1) // 4, *latent_hw)``, each clip encoded alone.
+
+    Single frames and clips of >= 5 latents use the direct ``encode_task`` path; clips of 2-4 latents, which it
+    rejects (its 5-frame temporal attention window must fit), use the chunked path (pads to the 45-frame chunk by
+    repeating the last frame, then trims). Both agree to < 1e-4 relative at 17 and 33 frames, 0.6% at one frame.
+    The encoder is causal in time, so the end padding does not change the kept latents (verified on AgiBot clips:
+    k-frame prefixes match the first latents of a longer encode to < 1e-4 relative).
+    """
+    t = videos.shape[2]
+    n_latents = 1 + (t - 1) // packing.TEMPORAL_DOWNSAMPLE
+    if t == 1 or n_latents >= 5:  # the direct path fits: no padding to 45 frames (same latents, < 1e-4 / 0.6%)
+        lat = vae.encode_task(videos.to(torch.bfloat16)).clone()
+    else:
+        lat = vae.encode(videos.to(torch.bfloat16)).clone()
+    return lat[..., : latent_hw[0], : latent_hw[1]]
+
+
+def latent_times(n_latents: int, first_frame: int, fps: float, batch: int) -> Tensor:
+    """Seconds of causal latents ``0..n-1`` of a clip starting at frame ``first_frame``: latent ``j`` -> frame
+    ``first_frame + 4 j`` (the last frame it summarizes)."""
+    frames = first_frame + torch.arange(n_latents).float() * packing.TEMPORAL_DOWNSAMPLE
+    return (frames / fps)[None].expand(batch, -1)
+
+
+def pack(cond: Tensor | None, future: Tensor, k: int, fps: float) -> dict[str, Tensor]:
+    """Context latents ``(B, 96, nc, h, w)`` or None, future latents ``(B, 96, nf, h, w)`` -> stream tensors + ids."""
+    b = future.shape[0]
+    out = {}
+    if cond is not None and cond.shape[2]:
+        tok, ids = batched_prc_vid(cond.to(torch.bfloat16), times_to_ids(latent_times(cond.shape[2], 0, fps, b)))
+        out.update(x_video_cond=tok, x_video_cond_ids=ids)
+    tok, ids = batched_prc_vid(future.to(torch.bfloat16), times_to_ids(latent_times(future.shape[2], k, fps, b)))
+    out.update(x_video=tok, x_video_ids=ids)
+    return out
+
+
+def sample_video_timesteps(n: int, mean: float, std: float, generator: torch.Generator | None = None) -> Tensor:
+    """``t = sigmoid(N(mean, std))`` (t = 1 is noise): the trunk's video timestep distribution
+    (``PolicyConfig.video_logit_mean/std``, used for video tokens by the SO-101 history recipe)."""
+    return torch.sigmoid(torch.randn(n, generator=generator) * std + mean)
+
+
+def forward_kwargs(video: dict[str, Tensor], t: Tensor) -> tuple[dict[str, Tensor], Tensor]:
+    """Noise ``x_video`` to ``t`` (one per window); the context stays clean at timestep 0. -> (kwargs, target)."""
+    xv, target = packing.add_noise(video["x_video"], t)
+    dev = xv.device
+    tt = t.to(device=dev, dtype=xv.dtype).float()  # the rounded value the noising used
+    kw = {
+        "x_video": xv,
+        "x_video_ids": video["x_video_ids"].to(dev),
+        "x_video_timesteps": tt[:, None] * torch.ones(xv.shape[:2], device=dev),
+    }
+    if "x_video_cond" in video:
+        kw.update(
+            x_video_cond=video["x_video_cond"],
+            x_video_cond_ids=video["x_video_cond_ids"].to(dev),
+            x_video_cond_timesteps=torch.zeros(video["x_video_cond"].shape[:2], device=dev),
+        )
+    return kw, target
+
+
+def flow_loss(pred: Tensor, target: Tensor) -> dict[str, Tensor]:
+    """Velocity MSE over the future tokens only (every window has the same token count)."""
+    mse = ((pred.float() - target.float()) ** 2).mean()
+    return {"loss": mse, "video_mse": mse.detach(), "action_mse": torch.zeros((), device=mse.device)}
